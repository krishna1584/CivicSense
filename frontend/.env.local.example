# CivicSense frontend settings.
# Copy this file to `.env.local` for local development. On Vercel, set these in the
# project's Environment Variables. They are built into the browser bundle, so never
# put secrets here.

# REQUIRED IN PRODUCTION — address of the backend API, without a trailing slash.
# Defaults to http://localhost:5000 when not set.
NEXT_PUBLIC_API_URL=http://localhost:5000

# OPTIONAL — only if live updates (Socket.IO) are served from a different address
# than the API. Defaults to NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
