# CivicSense backend settings.
# Copy this file to `.env` for local development. On a host (Render, etc.) set these
# as environment variables instead. The server checks them at startup and stops with
# a clear message if a required one is missing.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — the server will not start without these
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/civicsense

# Two different long random strings (at least 32 characters each). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION — safe to leave as-is for local development
# ─────────────────────────────────────────────────────────────────────────────

# Set to `production` on your host. Enables secure cross-site cookies and database SSL.
NODE_ENV=production

# Exact address of the frontend, without a trailing slash. Used to allow browser
# requests (CORS) and in links inside emails. Defaults to http://localhost:3000.
FRONTEND_URL=http://localhost:3000

# Email (verification and password-reset codes) is sent over SMTP with Nodemailer.
# Without these, codes are only printed to the server console in development and are
# not sent at all in production.
# NOTE: Render's free plan blocks outgoing SMTP. The server detects this at startup and
# the sign-up and password-reset pages then show a notice explaining it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# For Gmail, use an App Password (Google Account → Security → App passwords)
SMTP_PASS=

# Sender shown on emails. Defaults to SMTP_USER.
# EMAIL_FROM="CivicSense" <no-reply@yourdomain.com>

# Image storage (https://cloudinary.com). Without it, uploads are saved to the server's
# disk, which most hosts wipe on every redeploy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — defaults shown
# ─────────────────────────────────────────────────────────────────────────────

# Port to listen on. Most hosts set this for you.
# PORT=5000

# Extra frontend addresses allowed to call the API, comma separated
# (for example a Vercel preview deployment).
# CORS_EXTRA_ORIGINS=https://my-preview.vercel.app

# Work required from anonymous reporters' browsers, in bits. Each +1 doubles it.
# POW_DIFFICULTY_BITS=16
